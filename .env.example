# Closed Loop configuration
#
# Copy to .env (./closed-loop.sh setup does this for you) and edit as needed.
# .env is gitignored; this file is the tracked template. Both docker compose
# and ./closed-loop.sh read .env, so one edit here reaches the container stack
# and the local dev servers alike.

# ─────────────────────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────────────────────

# The dashboard and API (one container serves both).
CLOSED_LOOP_PORT=8000

# Used only by `./closed-loop.sh dev`.
BACKEND_PORT=8000
FRONTEND_PORT=5173

# ─────────────────────────────────────────────────────────────────────────────
# Local model runtime
# ─────────────────────────────────────────────────────────────────────────────

# Ollama defaults to the host: GPU passthrough is simpler there and the model
# cache survives container rebuilds.
#   Host (default):        http://host.docker.internal:11434
#   Containerised:         http://ollama:11434
#                          (start it with `./closed-loop.sh start --with-ollama`)
#
# If you run the app in Docker and Ollama on the host, start Ollama with
#
#     OLLAMA_HOST=0.0.0.0 ollama serve
#
# It binds 127.0.0.1 by default and refuses everything else, so a container
# reaches host.docker.internal, finds the address resolves, and then times out
# against a port that will not talk to it. `./closed-loop.sh dev` is
# unaffected: the backend runs on the host and the client falls back to
# localhost.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# ─────────────────────────────────────────────────────────────────────────────
# Low-resource tuning (defaults suit a 4-core, 8 GB laptop with no GPU)
# ─────────────────────────────────────────────────────────────────────────────
#
# The OLLAMA_* names are Ollama's own: `./closed-loop.sh dev --host` starts
# `ollama serve` with them, the --with-ollama container gets them, and the
# backend also sends the per-request ones with every chat, so they hold even
# against an Ollama you started yourself. Best model on 8 GB RAM, CPU only:
# qwen3:1.7b (or qwen3:0.6b / gemma3:1b on 4 GB) — or use a cloud API.

# Context window per request. The snapshot + 10 chat turns fit in 4096;
# halving it roughly halves the model's KV-cache RAM.
OLLAMA_CONTEXT_LENGTH=4096
# Longest reply, in tokens. Insights are 2–4 sentences (~150).
OLLAMA_NUM_PREDICT=1024
# How long the model stays in RAM after a reply. Shorter frees RAM sooner;
# the next answer then pays the load time again.
OLLAMA_KEEP_ALIVE=10m
# One request at a time, one model in RAM: chat and insights queue instead of
# each loading a copy.
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
# Smaller KV cache (q8_0 needs flash attention). Server-side only.
OLLAMA_FLASH_ATTENTION=1
OLLAMA_KV_CACHE_TYPE=q8_0
# CPU threads Ollama uses per request; empty = Ollama decides (all cores).
OLLAMA_NUM_THREAD=

# CPU threads for the ML predictor (scikit-learn, XGBoost, SHAP). Scoring a
# cycle is tiny; 1–2 threads leave the rest of the CPU to the language model.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2
