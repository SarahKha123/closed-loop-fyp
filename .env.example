# Closed Loop configuration
#
# Copy to .env (./closed-loop.sh setup does this for you) and edit as needed.
# .env is gitignored; this file is the tracked template. closed-loop.sh reads
# .env and exports it to the backend.

# ─────────────────────────────────────────────────────────────────────────────
# Ports
# ─────────────────────────────────────────────────────────────────────────────

# The API — and with `./closed-loop.sh start`, the dashboard too.
BACKEND_PORT=8000
# The Vite dev server, `./closed-loop.sh dev` only.
FRONTEND_PORT=5173

# ─────────────────────────────────────────────────────────────────────────────
# Language model (cloud)
# ─────────────────────────────────────────────────────────────────────────────
#
# There is no server key. Each user saves their own key on the AI model page;
# it is stored encrypted in the database, linked to their account, and never
# sent back to a browser. It answers their chat, and the live insights while
# they drive the replay (whoever last pressed Play pays).
# Encrypts users' saved keys. Empty: a random one is made once in config/secret.key.
# Set it on a deployed server (any long random string, e.g. `openssl rand -base64 48`)
# and keep it: if it changes, saved keys can't be read and users paste theirs again.
KEY_ENCRYPTION_SECRET=

# CPU threads for the ML predictor (scikit-learn, XGBoost, SHAP). Scoring a
# cycle is tiny; 1–2 threads are plenty.
OMP_NUM_THREADS=2
OPENBLAS_NUM_THREADS=2
MKL_NUM_THREADS=2

# ─────────────────────────────────────────────────────────────────────────────
# Sign-in
# ─────────────────────────────────────────────────────────────────────────────
#
# "Continue with Google" appears on the sign-in page once both are set. Create
# them in Google Cloud console (docs/GOOGLE_AUTH_PORTABLE.md §3): a *Web
# application* OAuth client whose redirect URI is APP_URL + /api/auth/google/callback,
# e.g. http://localhost:5173/api/auth/google/callback for ./closed-loop.sh dev
# (http://localhost:8000/... for ./closed-loop.sh start). Never commit them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The origin the browser uses. Empty = taken from each request, fine on localhost;
# set it in production (it must match the redirect URI in the console exactly).
APP_URL=
# true when served over HTTPS: the session cookie is then never sent over plain http.
COOKIE_SECURE=false
# Days a sign-in lasts before asking again.
SESSION_TTL_DAYS=7
# New accounts. true: anyone can sign up (and a demo/demo account is made on
# first start). Set false on a deployed server: no sign-up form, no new Google
# accounts, no demo account; add people with
#   backend/.venv/bin/python -m app.services.auth add <username> "<Name>"   (from backend/)
ALLOW_SIGNUP=true

# ─────────────────────────────────────────────────────────────────────────────
# Email notifications (an email for every work order that opens)
# ─────────────────────────────────────────────────────────────────────────────
#
# Sent through Gmail. SMTP_APP_PASSWORD is a Google *App Password*, not the
# account password: turn on 2-Step Verification for the Gmail account, then
# create one at https://myaccount.google.com/apppasswords (16 letters; the
# spaces Google shows are fine). Gmail allows roughly 500 emails a day.
# Off until all three are set; mute it any time on the AI model page (Advisor behaviour). Never commit these.
# Set APP_URL above to get a link to the Work orders page in each email.
SMTP_USER=
SMTP_APP_PASSWORD=
# Who receives them, comma-separated.
NOTIFY_EMAIL_TO=
